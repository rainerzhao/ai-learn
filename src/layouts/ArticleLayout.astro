---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs';
import { withBase } from '../lib/paths';
import type { NavArticle } from '../lib/navigation';

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  description?: string;
  breadcrumbs: BreadcrumbItem[];
  tags?: string[];
  date?: string | Date;
  previousArticle?: NavArticle;
  nextArticle?: NavArticle;
}

const { title, description, breadcrumbs, tags = [], date, previousArticle, nextArticle } = Astro.props;

function formatDate(value: string | Date | undefined): string | undefined {
  if (!value) return undefined;
  const parsed = value instanceof Date ? value : new Date(value);
  if (Number.isNaN(parsed.getTime())) return String(value);
  return parsed.toISOString().slice(0, 10);
}

const displayDate = formatDate(date);
---

<BaseLayout title={title} description={description}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs items={breadcrumbs} />

    <article class="prose mt-6">
      <header class="mb-8">
        <h1 class="text-4xl font-bold mb-4" style="color: var(--text-primary)">{title}</h1>
        <div class="flex flex-wrap items-center gap-4 text-sm" style="color: var(--text-muted)">
          {displayDate && <time datetime={displayDate}>{displayDate}</time>}
          {tags.length > 0 && (
            <div class="flex flex-wrap gap-2">
              {tags.map(tag => (
                <a
                  href={withBase(`/tags/${encodeURIComponent(tag)}/`)}
                  class="px-2 py-0.5 rounded text-xs font-medium"
                  style="background: var(--bg-secondary); color: var(--accent); border: 1px solid var(--border)"
                >
                  {tag}
                </a>
              ))}
            </div>
          )}
        </div>
      </header>

      <div class="article-content">
        <slot />
      </div>

      {(previousArticle || nextArticle) && (
        <nav class="article-next-nav" aria-label="继续学习">
          {previousArticle ? (
            <a class="article-next-nav__item" href={previousArticle.href}>
              <span>上一篇</span>
              <strong>{previousArticle.title}</strong>
            </a>
          ) : (
            <span></span>
          )}
          {nextArticle && (
            <a class="article-next-nav__item article-next-nav__item--next" href={nextArticle.href}>
              <span>继续下一篇</span>
              <strong>{nextArticle.title}</strong>
            </a>
          )}
        </nav>
      )}
    </article>
  </div>
</BaseLayout>
