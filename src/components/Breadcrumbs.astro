---
import { withBase } from '../lib/paths';

interface Props {
  items: { label: string; href?: string }[];
}

const { items } = Astro.props;
---

<nav aria-label="面包屑导航" class="text-sm mb-4" style="color: var(--text-muted);">
  <ol class="flex flex-wrap items-center gap-1">
    <li>
      <a href={withBase('/')} class="hover:underline" style="color: var(--accent);">首页</a>
    </li>
    {items.map(item => (
      <li class="flex items-center gap-1">
        <span style="color: var(--text-muted);">/</span>
        {item.href ? (
          <a href={withBase(item.href)} class="hover:underline" style="color: var(--accent);">
            {item.label}
          </a>
        ) : (
          <span style="color: var(--text-primary);">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
