---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs';
import SketchCard from '../components/SketchCard.astro';
import { AI_SUPPLEMENT_POINTS, IAAS_TRANSITION_TRACKS, SKETCH_MODULES, countSketches } from '../lib/knowledge-sketches';
import { withBase } from '../lib/paths';

const totalSketches = countSketches();
const transitionSketchCount = IAAS_TRANSITION_TRACKS.reduce((sum, track) => sum + track.sketches.length, 0);
const STORY_CHAPTERS = [
  {
    id: 'story-rename',
    title: '先把旧能力重新命名',
    scene: 'IaaS 架构师不是从零开始，而是把资源池、控制面、交付经验翻译成 token 工厂、模型生命周期和 GPU 物理约束。',
    why: '读完这一幕，先建立转型心智：你过去管的是机器，现在要管智能吞吐。',
    goal: '把 IaaS 的资源交付、控制面和运维经验，改写成 AI Infra 的架构语言。',
    outcome: '能说清“算力交付”和“智能吞吐交付”的差异，并列出自己已有能力的迁移清单。',
    nextStep: [{ label: '继续看算力底座', href: '#story-compute' }],
    transitionIds: ['iaas-ai-mental-model'],
    moduleDirs: ['01_hardware_architecture'],
  },
  {
    id: 'story-compute',
    title: '再看清 AI 的算力底座',
    scene: '当模型变成工作负载，瓶颈会从 CPU/内存利用率转向 GPU 显存、HBM、Kernel、互联网络、存储和容量曲线。',
    why: '这一幕回答“为什么同样有卡，有的平台跑得稳，有的平台一直慢”。',
    goal: '建立 GPU、网络、存储、调度和容量规划之间的因果图。',
    outcome: '能从训练和推理两类负载出发，判断瓶颈更可能在显存、互联、存储还是调度策略。',
    nextStep: [{ label: '进入模型平台对象', href: '#story-model' }],
    transitionIds: ['iaas-ai-capacity', 'iaas-ai-network-storage'],
    moduleDirs: ['02_gpu_programming', '03_ai_cluster_operations', '04_cloud_native_ai_platform'],
  },
  {
    id: 'story-model',
    title: '然后让模型成为平台对象',
    scene: 'AI 架构不是只部署一个服务，而是管理训练、微调、评测、版本、上下文、模型行为和服务运行时。',
    why: '这一幕把算法概念变成平台可以管理、观测、发布和回滚的对象。',
    goal: '把模型从“算法资产”提升为可发布、可观测、可回滚的平台对象。',
    outcome: '能设计模型版本、评测、训练/微调、推理运行时之间的最小平台闭环。',
    nextStep: [
      { label: '接入 RAG/Agent 工作流', href: '#story-application' },
      { label: '先看治理与 SRE', href: '#story-govern' },
    ],
    transitionIds: [],
    moduleDirs: ['05_model_training_and_fine_tuning', '06_llm_theory_and_foundation', '09_inference_system'],
  },
  {
    id: 'story-application',
    title: '接着把模型接进真实工作流',
    scene: '模型要通过 RAG、工具、Agent、代码接口和业务流程产生价值；这里开始从“能回答”走向“能办事”。',
    why: '这一幕说明 AI 架构师为什么必须懂上下文、工具协议、状态和失败边界。',
    goal: '把模型能力嵌入检索、工具调用、Agent 状态机和业务流程。',
    outcome: '能画出一个 RAG/Agent 系统的上下文来源、工具边界、失败处理和可观测点。',
    nextStep: [{ label: '补齐治理与运营', href: '#story-govern' }],
    transitionIds: ['iaas-ai-delivery'],
    moduleDirs: ['07_rag_and_tools', '08_agentic_system', '98_llm_programming'],
  },
  {
    id: 'story-govern',
    title: '最后把智能系统运营起来',
    scene: '上线以后，真正难的是 SLO、质量观测、安全隔离、模型供应链、FinOps 和持续治理。',
    why: '这一幕把 IaaS 的 SRE、安全和成本优势迁移到 AI 世界，是转型最能拉开差距的部分。',
    goal: '把 SRE、安全、成本和供应链治理迁移到模型与 Agent 系统。',
    outcome: '能为 AI 平台定义质量观测、风险边界、成本归因和持续改进机制。',
    nextStep: [{ label: '整理 30/90/180 天行动计划', href: '#story-roadmap' }],
    transitionIds: ['iaas-ai-platform-sre', 'iaas-ai-security', 'iaas-ai-cost-finops'],
    moduleDirs: ['99_tools_and_misc'],
  },
  {
    id: 'story-roadmap',
    title: '收束成 30/90/180 天路线图',
    scene: '前面都是能力地图，最后要落到可执行节奏：补语言、做链路、沉淀平台能力。',
    why: '这一幕让学习顺序变成行动计划，而不是继续收藏知识点。',
    goal: '把前 5 幕的能力地图压缩成可执行的阶段计划。',
    outcome: '能拆出 30 天补基础、90 天做链路、180 天沉淀平台能力的个人转型路线。',
    nextStep: [{ label: '回到首页选择模块', href: withBase('/#modules') }],
    transitionIds: ['iaas-ai-roadmap'],
    moduleDirs: ['10_ai_related_course'],
  },
];

const ROLE_ROUTES = [
  {
    name: 'Infra 路线',
    desc: '平台/运维 -> AI Infra 架构',
    href: '#story-rename',
  },
  {
    name: '平台路线',
    desc: '云原生/SRE -> AI 平台架构',
    href: '#story-model',
  },
  {
    name: '应用路线',
    desc: '应用架构 -> RAG/Agent 架构',
    href: '#story-application',
  },
];

const storyChapters = STORY_CHAPTERS.map((chapter, index) => {
  const tracks = chapter.transitionIds
    .map(id => IAAS_TRANSITION_TRACKS.find(track => track.id === id))
    .filter(Boolean);
  const modules = chapter.moduleDirs
    .map(moduleDir => SKETCH_MODULES.find(module => module.moduleDir === moduleDir))
    .filter(Boolean);
  const cardCount = tracks.reduce((sum, track) => sum + track.sketches.length, 0)
    + modules.reduce((sum, module) => sum + module.sketches.length, 0);

  return {
    ...chapter,
    index,
    tracks,
    modules,
    cardCount,
  };
});
---

<BaseLayout title="手绘知识卡" description="每个 AI 基础设施模块最核心的手绘知识点总览">
  <div class="sketch-page">
    <div class="sketch-page__inner">
      <Breadcrumbs items={[{ label: '手绘知识卡' }]} />

      <section class="sketch-hero">
        <div>
          <p class="sketch-kicker">Hand-drawn AI map</p>
          <h1>把 AI 基础设施画成能一眼抓住的 {totalSketches} 张卡</h1>
          <p>
            从 IaaS 架构师和运维负责人的视角出发，把“资源池、网络、存储、调度、SRE、安全、成本”
            与 AI 自身的“表示、上下文、评测、协议、系统边界、经济学”合在一张转型地图里。
          </p>
          <div class="sketch-hero__actions">
            <a href="#storyline" class="sketch-button">按故事线读</a>
            <a href="#iaas-transition" class="sketch-button">看转型地图</a>
            <a href={withBase('/#modules')} class="sketch-button sketch-button--ghost">回到模块</a>
          </div>
        </div>
        <div class="sketch-hero__stats" aria-label="手绘知识卡统计">
          <strong>{totalSketches}</strong>
          <span>核心手绘图</span>
          <strong>{SKETCH_MODULES.length}</strong>
          <span>知识模块</span>
          <strong>{IAAS_TRANSITION_TRACKS.length}</strong>
          <span>IaaS 转型专题</span>
        </div>
      </section>

      <nav class="role-route-nav" aria-label="AI 架构转型路线导览">
        {ROLE_ROUTES.map(route => (
          <a href={route.href}>
            <strong>{route.name}</strong>
            <span>{route.desc}</span>
          </a>
        ))}
      </nav>

      <section id="storyline" class="storyline">
        <div class="storyline__head">
          <p class="sketch-kicker">Reading storyline</p>
          <h2>60 张卡要按 6 幕读，不要按目录硬啃</h2>
          <p>
            这条线的主角是一个 IaaS 运维架构师：先把旧经验翻译成 AI 语言，再补算力底座、模型平台、应用工作流，
            最后回到 SRE、安全、成本和路线图。
          </p>
        </div>
        <ol class="storyline__steps" aria-label="手绘卡片故事线">
          {storyChapters.map(chapter => (
            <li>
              <a href={`#${chapter.id}`}>
                <span>{String(chapter.index + 1).padStart(2, '0')}</span>
                <strong>{chapter.title}</strong>
                <em>{chapter.cardCount} 张卡</em>
              </a>
            </li>
          ))}
        </ol>
      </section>

      <section id="iaas-transition" class="transition-board">
        <div class="transition-board__head">
          <div>
            <p class="sketch-kicker">IaaS x AI lens</p>
            <h2>从 IaaS 运维架构师转向 AI 架构师</h2>
            <p>
              这组不是把 IaaS 经验丢掉重学 AI，而是把两套语言合起来：IaaS 负责资源、网络、存储、SRE、安全和成本，
              AI 负责表示、上下文、评测、协议、边界和推理经济学。先补 {transitionSketchCount} 张，按真实转型问题切开。
            </p>
          </div>
          <div class="transition-board__stamp">
            <strong>{transitionSketchCount}</strong>
            <span>转型卡</span>
          </div>
        </div>

        <div class="ai-lens">
          <div class="ai-lens__heading">
            <p class="sketch-kicker">AI 自身视角</p>
            <h3>IaaS 能力要和 AI 的内部机制一起看</h3>
            <p>
              容量规划不能只看机器，要看 token、上下文和推理链路；稳定性不能只看进程，要看幻觉、漂移和评测闭环；
              平台治理也不能只看权限，要看模型边界、数据边界和调用协议。
            </p>
          </div>
          <div class="ai-lens__grid">
            {AI_SUPPLEMENT_POINTS.map(point => (
              <article>
                <h4>{point.title}</h4>
                <p>{point.desc}</p>
              </article>
            ))}
          </div>
        </div>

        <div class="track-nav" aria-label="IaaS 转 AI 架构专题导航">
          {storyChapters.map(chapter => (
            <a href={`#${chapter.id}`}>{chapter.index + 1}. {chapter.title}</a>
          ))}
        </div>

        <div class="story-chapters">
          {storyChapters.map(chapter => (
            <section class="story-chapter" id={chapter.id}>
              <div class="story-chapter__head">
                <div>
                  <p class="sketch-kicker">Chapter {String(chapter.index + 1).padStart(2, '0')}</p>
                  <h2>{chapter.title}</h2>
                  <p>{chapter.scene}</p>
                </div>
                <div class="story-chapter__why">
                  <span>为什么先读</span>
                  <p>{chapter.why}</p>
                </div>
              </div>

              <div class="story-chapter__map">
                {[...chapter.tracks, ...chapter.modules].map(item => (
                  <a href={`#${'moduleDir' in item ? item.moduleDir : item.id}`}>
                    {'icon' in item && item.icon}
                    {'moduleName' in item ? item.moduleName : item.name}
                  </a>
                ))}
              </div>

              <div class="story-chapter__tasks" aria-label={`${chapter.title} 的学习任务`}>
                <article>
                  <span>本章目标</span>
                  <p>{chapter.goal}</p>
                </article>
                <article>
                  <span>读完产出</span>
                  <p>{chapter.outcome}</p>
                </article>
                <article>
                  <span>下一步</span>
                  <div class="story-chapter__next">
                    {chapter.nextStep.map(step => (
                      <a href={step.href}>{step.label}</a>
                    ))}
                  </div>
                </article>
              </div>

              <div class="story-chapter__groups">
                {chapter.tracks.map(track => (
                  <section class="module-sketch-block transition-track" id={track.id}>
                    <div class="module-sketch-block__head">
                      <div>
                        <p class="sketch-kicker">Transition track</p>
                        <h3><span>{track.icon}</span>{track.name}</h3>
                        <p>{track.lens}</p>
                      </div>
                    </div>
                    <div class="sketch-grid">
                      {track.sketches.map((sketch, index) => (
                        <SketchCard sketch={sketch} index={index} moduleName={track.name} />
                      ))}
                    </div>
                  </section>
                ))}

                {chapter.modules.map(module => (
                  <section class="module-sketch-block" id={module.moduleDir}>
                    <div class="module-sketch-block__head">
                      <div>
                        <p class="sketch-kicker">Module {module.moduleId}</p>
                        <h3><span>{module.icon}</span>{module.moduleName}</h3>
                        <p>{module.aiLens}</p>
                      </div>
                      <a class="module-link" href={withBase(`/${module.moduleDir}/`)}>
                        进入模块
                      </a>
                    </div>
                    <div class="sketch-grid">
                      {module.sketches.map((sketch, index) => (
                        <SketchCard sketch={sketch} index={index} moduleName={module.moduleName} />
                      ))}
                    </div>
                  </section>
                ))}
              </div>
            </section>
          ))}
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .sketch-page {
    background:
      radial-gradient(circle at 8% 4%, color-mix(in srgb, var(--accent-warm) 12%, transparent), transparent 26rem),
      radial-gradient(circle at 92% 2%, color-mix(in srgb, var(--accent-cool) 14%, transparent), transparent 28rem),
      var(--bg-primary);
  }

  .sketch-page__inner {
    max-width: 80rem;
    margin: 0 auto;
    padding: 2rem 1rem 4rem;
  }

  @media (min-width: 640px) {
    .sketch-page__inner {
      padding-inline: 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .sketch-page__inner {
      padding-inline: 2rem;
    }
  }

  .sketch-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    align-items: end;
    margin-top: 1.25rem;
    padding: clamp(1.4rem, 4vw, 3rem);
    border: 1px solid var(--border);
    border-radius: 8px;
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--bg-card) 92%, transparent), color-mix(in srgb, var(--bg-secondary) 94%, transparent)),
      repeating-linear-gradient(-4deg, transparent 0 18px, color-mix(in srgb, var(--accent) 5%, transparent) 19px 20px);
    box-shadow: var(--soft-shadow);
  }

  @media (min-width: 900px) {
    .sketch-hero {
      grid-template-columns: minmax(0, 1fr) 15rem;
    }
  }

  .sketch-kicker {
    margin: 0 0 0.55rem;
    color: var(--accent);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .sketch-hero h1 {
    max-width: 52rem;
    margin: 0;
    color: var(--text-primary);
    font-size: clamp(2rem, 5vw, 4.35rem);
    line-height: 1.04;
    letter-spacing: 0;
  }

  .sketch-hero p:not(.sketch-kicker) {
    max-width: 48rem;
    margin: 1rem 0 0;
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.8;
  }

  .sketch-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.4rem;
  }

  .sketch-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.65rem;
    border-radius: 8px;
    padding: 0.65rem 1rem;
    background: var(--accent);
    color: #0f1117;
    font-weight: 900;
    text-decoration: none;
  }

  .sketch-button:hover {
    color: #0f1117;
    background: var(--accent-hover);
  }

  .sketch-button--ghost {
    border: 1px solid var(--border);
    background: var(--bg-card);
    color: var(--text-primary);
  }

  .sketch-button--ghost:hover {
    color: var(--accent);
    background: var(--bg-card-hover);
  }

  .sketch-hero__stats {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.3rem 0.75rem;
    align-items: baseline;
    padding: 1.1rem;
    border: 1px dashed color-mix(in srgb, var(--accent) 55%, var(--border));
    border-radius: 8px;
    background: var(--bg-card);
  }

  .sketch-hero__stats strong {
    color: var(--accent);
    font-size: 2.4rem;
    line-height: 1;
  }

  .sketch-hero__stats span {
    color: var(--text-secondary);
    font-size: 0.88rem;
  }

  .role-route-nav {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .role-route-nav a {
    min-width: 0;
    border: 1px solid color-mix(in srgb, var(--accent) 32%, var(--border));
    border-radius: 8px;
    padding: 0.9rem 1rem;
    background: var(--bg-card);
    color: var(--text-primary);
  }

  .role-route-nav a:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .role-route-nav strong,
  .role-route-nav span {
    display: block;
  }

  .role-route-nav strong {
    color: var(--accent);
    font-size: 0.95rem;
  }

  .role-route-nav span {
    margin-top: 0.25rem;
    color: var(--text-secondary);
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .storyline {
    margin-top: 1.5rem;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--bg-card) 88%, transparent), color-mix(in srgb, var(--bg-secondary) 96%, transparent)),
      repeating-linear-gradient(90deg, transparent 0 31px, color-mix(in srgb, var(--accent) 5%, transparent) 32px 33px);
  }

  .storyline__head {
    display: grid;
    gap: 0.35rem;
  }

  .storyline h2 {
    margin: 0;
    color: var(--text-primary);
    font-size: clamp(1.5rem, 3vw, 2.4rem);
    line-height: 1.16;
  }

  .storyline__head p:not(.sketch-kicker) {
    max-width: 58rem;
    margin: 0;
    color: var(--text-secondary);
    line-height: 1.75;
  }

  .storyline__steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    gap: 0.7rem;
    margin: 1.1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .storyline__steps a {
    display: grid;
    min-height: 8.6rem;
    align-content: space-between;
    gap: 0.7rem;
    border: 1px dashed color-mix(in srgb, var(--accent) 45%, var(--border));
    border-radius: 8px;
    padding: 0.85rem;
    background: color-mix(in srgb, var(--bg-card) 86%, transparent);
    color: var(--text-primary);
  }

  .storyline__steps a:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .storyline__steps span {
    color: var(--accent);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.08em;
  }

  .storyline__steps strong {
    font-size: 1rem;
    line-height: 1.35;
  }

  .storyline__steps em {
    color: var(--text-muted);
    font-size: 0.78rem;
    font-style: normal;
    font-weight: 800;
  }

  .ai-lens {
    margin: 1rem 0 1.25rem;
    padding: 1.25rem;
    border: 1px dashed color-mix(in srgb, var(--accent-warm) 48%, var(--border));
    border-radius: 8px;
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--bg-card) 88%, transparent), color-mix(in srgb, var(--bg-secondary) 94%, transparent)),
      repeating-linear-gradient(2deg, transparent 0 17px, color-mix(in srgb, var(--accent-warm) 5%, transparent) 18px 19px);
  }

  .ai-lens__heading {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    margin-bottom: 1rem;
  }

  .ai-lens h3 {
    margin: 0;
    font-size: 1.25rem;
  }

  .ai-lens__heading p:not(.sketch-kicker) {
    max-width: 58rem;
    margin: 0.2rem 0 0;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .ai-lens__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 0.75rem;
  }

  .ai-lens article {
    min-width: 0;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.9rem;
    background: var(--bg-secondary);
  }

  .ai-lens h4 {
    margin: 0 0 0.35rem;
    color: var(--accent);
    font-size: 0.96rem;
  }

  .ai-lens p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.86rem;
    line-height: 1.65;
  }

  .transition-board {
    margin-top: 1.5rem;
