---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs';
import SketchCard from '../components/SketchCard.astro';
import { AI_SUPPLEMENT_POINTS, IAAS_TRANSITION_TRACKS, SKETCH_MODULES, countSketches } from '../lib/knowledge-sketches';
import { withBase } from '../lib/paths';

const totalSketches = countSketches();
const transitionSketchCount = IAAS_TRANSITION_TRACKS.reduce((sum, track) => sum + track.sketches.length, 0);
---

<BaseLayout title="手绘知识卡" description="每个 AI 基础设施模块最核心的手绘知识点总览">
  <div class="sketch-page">
    <div class="sketch-page__inner">
      <Breadcrumbs items={[{ label: '手绘知识卡' }]} />

      <section class="sketch-hero">
        <div>
          <p class="sketch-kicker">Hand-drawn AI map</p>
          <h1>把 AI 基础设施画成能一眼抓住的 {totalSketches} 张卡</h1>
          <p>
            从 IaaS 架构师和运维负责人的视角出发，把“资源池、网络、存储、调度、SRE、安全、成本”
            翻译成 AI 架构里的 GPU 集群、模型服务、RAG、Agent、评测和治理。
          </p>
          <div class="sketch-hero__actions">
            <a href="#iaas-transition" class="sketch-button">看转型路线</a>
            <a href="#all-sketches" class="sketch-button">开始看图</a>
            <a href={withBase('/#modules')} class="sketch-button sketch-button--ghost">回到模块</a>
          </div>
        </div>
        <div class="sketch-hero__stats" aria-label="手绘知识卡统计">
          <strong>{totalSketches}</strong>
          <span>核心手绘图</span>
          <strong>{SKETCH_MODULES.length}</strong>
          <span>知识模块</span>
          <strong>{IAAS_TRANSITION_TRACKS.length}</strong>
          <span>IaaS 转型专题</span>
        </div>
      </section>

      <section class="ai-lens">
        <div class="ai-lens__heading">
          <p class="sketch-kicker">AI 自身视角</p>
          <h2>建议额外补充的横向知识点</h2>
        </div>
        <div class="ai-lens__grid">
          {AI_SUPPLEMENT_POINTS.map(point => (
            <article>
              <h3>{point.title}</h3>
              <p>{point.desc}</p>
            </article>
          ))}
        </div>
      </section>

      <section id="iaas-transition" class="transition-board">
        <div class="transition-board__head">
          <div>
            <p class="sketch-kicker">IaaS architect path</p>
            <h2>从 IaaS 运维架构师转向 AI 架构师</h2>
            <p>
              这组不是按原有模块切，而是按真实转型要跨过的架构问题切。先补 {transitionSketchCount} 张，
              覆盖心智、容量、网络存储、SRE、安全、成本、交付和路线图。
            </p>
          </div>
          <div class="transition-board__stamp">
            <strong>{transitionSketchCount}</strong>
            <span>转型卡</span>
          </div>
        </div>

        <div class="track-nav" aria-label="IaaS 转 AI 架构专题导航">
          {IAAS_TRANSITION_TRACKS.map(track => (
            <a href={`#${track.id}`}>{track.icon}{track.name}</a>
          ))}
        </div>

        <div class="all-sketches">
          {IAAS_TRANSITION_TRACKS.map(track => (
            <section class="module-sketch-block transition-track" id={track.id}>
              <div class="module-sketch-block__head">
                <div>
                  <p class="sketch-kicker">Transition track</p>
                  <h2><span>{track.icon}</span>{track.name}</h2>
                  <p>{track.lens}</p>
                </div>
              </div>
              <div class="sketch-grid">
                {track.sketches.map((sketch, index) => (
                  <SketchCard sketch={sketch} index={index} moduleName={track.name} />
                ))}
              </div>
            </section>
          ))}
        </div>
      </section>

      <section id="all-sketches" class="all-sketches">
        {SKETCH_MODULES.map(module => (
          <section class="module-sketch-block" id={module.moduleDir}>
            <div class="module-sketch-block__head">
              <div>
                <p class="sketch-kicker">Module {module.moduleId}</p>
                <h2><span>{module.icon}</span>{module.moduleName}</h2>
                <p>{module.aiLens}</p>
              </div>
              <a class="module-link" href={withBase(`/${module.moduleDir}/`)}>
                进入模块
              </a>
            </div>
            <div class="sketch-grid">
              {module.sketches.map((sketch, index) => (
                <SketchCard sketch={sketch} index={index} moduleName={module.moduleName} />
              ))}
            </div>
          </section>
        ))}
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .sketch-page {
    background:
      radial-gradient(circle at 8% 4%, color-mix(in srgb, var(--accent-warm) 12%, transparent), transparent 26rem),
      radial-gradient(circle at 92% 2%, color-mix(in srgb, var(--accent-cool) 14%, transparent), transparent 28rem),
      var(--bg-primary);
  }

  .sketch-page__inner {
    max-width: 80rem;
    margin: 0 auto;
    padding: 2rem 1rem 4rem;
  }

  @media (min-width: 640px) {
    .sketch-page__inner {
      padding-inline: 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .sketch-page__inner {
      padding-inline: 2rem;
    }
  }

  .sketch-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    align-items: end;
    margin-top: 1.25rem;
    padding: clamp(1.4rem, 4vw, 3rem);
    border: 1px solid var(--border);
    border-radius: 8px;
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--bg-card) 92%, transparent), color-mix(in srgb, var(--bg-secondary) 94%, transparent)),
      repeating-linear-gradient(-4deg, transparent 0 18px, color-mix(in srgb, var(--accent) 5%, transparent) 19px 20px);
    box-shadow: var(--soft-shadow);
  }

  @media (min-width: 900px) {
    .sketch-hero {
      grid-template-columns: minmax(0, 1fr) 15rem;
    }
  }

  .sketch-kicker {
    margin: 0 0 0.55rem;
    color: var(--accent);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .sketch-hero h1 {
    max-width: 52rem;
    margin: 0;
    color: var(--text-primary);
    font-size: clamp(2rem, 5vw, 4.35rem);
    line-height: 1.04;
    letter-spacing: 0;
  }

  .sketch-hero p:not(.sketch-kicker) {
    max-width: 48rem;
    margin: 1rem 0 0;
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.8;
  }

  .sketch-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.4rem;
  }

  .sketch-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.65rem;
    border-radius: 8px;
    padding: 0.65rem 1rem;
    background: var(--accent);
    color: #0f1117;
    font-weight: 900;
    text-decoration: none;
  }

  .sketch-button:hover {
    color: #0f1117;
    background: var(--accent-hover);
  }

  .sketch-button--ghost {
    border: 1px solid var(--border);
    background: var(--bg-card);
    color: var(--text-primary);
  }

  .sketch-button--ghost:hover {
    color: var(--accent);
    background: var(--bg-card-hover);
  }

  .sketch-hero__stats {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.3rem 0.75rem;
    align-items: baseline;
    padding: 1.1rem;
    border: 1px dashed color-mix(in srgb, var(--accent) 55%, var(--border));
    border-radius: 8px;
    background: var(--bg-card);
  }

  .sketch-hero__stats strong {
    color: var(--accent);
    font-size: 2.4rem;
    line-height: 1;
  }

  .sketch-hero__stats span {
    color: var(--text-secondary);
    font-size: 0.88rem;
  }

  .ai-lens {
    margin-top: 1.5rem;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg-card);
  }

  .ai-lens__heading {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    margin-bottom: 1rem;
  }

  .ai-lens h2 {
    margin: 0;
    font-size: 1.25rem;
  }

  .ai-lens__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 0.75rem;
  }

  .ai-lens article {
    min-width: 0;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.9rem;
    background: var(--bg-secondary);
  }

  .ai-lens h3 {
    margin: 0 0 0.35rem;
    color: var(--accent);
    font-size: 0.96rem;
  }

  .ai-lens p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.86rem;
    line-height: 1.65;
  }

  .transition-board {
    margin-top: 1.5rem;
    padding: 1.1rem;
    border: 1px solid color-mix(in srgb, var(--accent-warm) 38%, var(--border));
    border-radius: 8px;
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--bg-card) 86%, transparent), color-mix(in srgb, var(--bg-secondary) 92%, transparent)),
      repeating-linear-gradient(-3deg, transparent 0 19px, color-mix(in srgb, var(--accent-warm) 7%, transparent) 20px 21px);
  }

  .transition-board__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    align-items: end;
    margin-bottom: 1rem;
  }

  @media (min-width: 760px) {
    .transition-board__head {
      grid-template-columns: minmax(0, 1fr) 8rem;
    }
  }

  .transition-board h2 {
    margin: 0;
    color: var(--text-primary);
    font-size: clamp(1.45rem, 3vw, 2.35rem);
    line-height: 1.16;
  }

  .transition-board__head p:not(.sketch-kicker) {
    max-width: 54rem;
    margin: 0.65rem 0 0;
    color: var(--text-secondary);
    line-height: 1.75;
  }

  .transition-board__stamp {
    display: grid;
    place-items: center;
    min-height: 6.5rem;
    border: 2px dashed color-mix(in srgb, var(--accent-warm) 58%, var(--border));
    border-radius: 8px;
    background: var(--bg-card);
    transform: rotate(1.5deg);
  }

  .transition-board__stamp strong {
    color: var(--accent-warm);
    font-size: 2.2rem;
    line-height: 1;
  }

  .transition-board__stamp span {
    color: var(--text-secondary);
    font-size: 0.82rem;
    font-weight: 800;
  }

  .track-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-bottom: 1rem;
  }

  .track-nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.35rem 0.65rem;
    background: var(--bg-card);
    color: var(--text-primary);
    font-size: 0.78rem;
    font-weight: 800;
  }

  .track-nav a:hover {
    border-color: var(--accent-warm);
    color: var(--accent-warm);
  }

  .all-sketches {
    display: grid;
    gap: 1.35rem;
    margin-top: 1.5rem;
  }

  .module-sketch-block {
    scroll-margin-top: 5rem;
    padding: 1.1rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: color-mix(in srgb, var(--bg-card) 84%, transparent);
  }

  .transition-track {
    background: color-mix(in srgb, var(--bg-card) 90%, var(--accent-warm) 3%);
  }

  .module-sketch-block__head {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  @media (min-width: 760px) {
    .module-sketch-block__head {
      flex-direction: row;
      align-items: end;
    }
  }

  .module-sketch-block h2 {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0;
    font-size: 1.35rem;
  }

  .module-sketch-block__head p:not(.sketch-kicker) {
    max-width: 54rem;
    margin: 0.45rem 0 0;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .module-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    min-height: 2.3rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.45rem 0.75rem;
    background: var(--bg-secondary);
    color: var(--text-primary);
    font-size: 0.85rem;
    font-weight: 800;
  }

  .module-link:hover {
    color: var(--accent);
    background: var(--bg-card-hover);
  }

  .sketch-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 1rem;
  }
</style>
